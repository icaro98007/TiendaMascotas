# Configuración del Entorno de Revisión Documental Privado
# Nota: La aplicación procesa todos los datos estrictamente en memoria del navegador
# No requiere ni utiliza claves secretas de APIs externas por diseño de privacidad.

PORT=8080
APP_NAME="Revisión de solicitudes de crédito"
PRIVACY_MODE=STRICT_LOCAL_IN_MEMORY
ENABLE_OUTPUT_EXPORT=false
